#%RAML 1.0
title: Complex Types API

types:
  MoneyResponse:
    type: object
    properties:
      id:
        type: string
        pattern: ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$
      amount:
        type: number

  Paging:
    type: object
    properties:
      cursor: string